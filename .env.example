# Copy to .env.local for local development, or set these in your host's dashboard.

# Public origin of the site — used for metadataBase, canonical URLs, sitemap.xml
# and robots.txt. On Vercel this is already provided by vercel.json.
NEXT_PUBLIC_SITE_URL=https://lumora.gulplaza.net

# Optional: override where the JSON datastore lives. On serverless hosts only
# /tmp is writable; the app falls back to /tmp/lumora-data automatically when
# it detects Vercel. Point this at a mounted volume for durable persistence.
# LUMORA_DATA_DIR=/tmp/lumora-data
